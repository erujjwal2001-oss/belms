@using BELMS.Frontend.Features.Dashboard.Core

@using BELMS.Frontend.Features.Dashboard.Manager.Services



@if (_model is null)

{

    <DashboardLoadingPlaceholder />

}

else

{

    <DashboardPageHeader Title="Manager Dashboard" Subtitle="@_model.WelcomeMessage" Role="@BelmsRoles.Manager" />

    <DashboardStatGrid Stats="@_model.Stats" Role="@BelmsRoles.Manager" />



    <MudGrid Spacing="3" Class="mt-1">

        <MudItem xs="12" lg="8">

            <PendingTasksTable Title="Pending Approvals" Items="@_model.PendingTasks" ShowActions="true" />

        </MudItem>

        <MudItem xs="12" lg="4">

            <TeamMemberList Members="@_model.TeamMembers" />

        </MudItem>

    </MudGrid>



    <MudGrid Spacing="3" Class="mt-1">

        <MudItem xs="12">

            <ActivityFeed Items="@_model.RecentActivity" />

        </MudItem>

    </MudGrid>

}



@code {

    [Inject]

    private IManagerDashboardService DashboardService { get; set; } = default!;



    private Manager.Models.ManagerDashboardModel? _model;



    protected override async Task OnInitializedAsync() =>

        _model = await DashboardService.GetDashboardAsync();

}

