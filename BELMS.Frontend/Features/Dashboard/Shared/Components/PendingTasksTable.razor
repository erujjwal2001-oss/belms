@using BELMS.Frontend.Features.Dashboard.Shared.Models

<MudCard Class="h-100">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">@Title</MudText>
                @if (ShowActions && Items.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@Items.Count pending</MudChip>
                }
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pa-0">
        @if (Items.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No pending tasks.</MudText>
        }
        else
        {
            <MudTable Items="@Items" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Task</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Assignee</MudTh>
                    <MudTh>Due</MudTh>
                    @if (ShowActions)
                    {
                        <MudTh Style="text-align: right">Actions</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Task">@context.Title</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Assignee">@context.Assignee</MudTd>
                    <MudTd DataLabel="Due">@context.DueDate.ToString("dd MMM yyyy")</MudTd>
                    @if (ShowActions)
                    {
                        <MudTd DataLabel="Actions" Style="text-align: right">
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Class="mr-1">Approve</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error">Reject</MudButton>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public string Title { get; set; } = "Pending Tasks";

    [Parameter]
    public IReadOnlyList<PendingTask> Items { get; set; } = [];

    [Parameter]
    public bool ShowActions { get; set; }

    private static Color GetStatusColor(string status) => status switch
    {
        "Pending" => Color.Warning,
        "In Review" => Color.Info,
        "Approved" => Color.Success,
        _ => Color.Default
    };
}
