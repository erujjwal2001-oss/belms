@using BELMS.Frontend.Common.Layout
@using BELMS.Frontend.Theme
@using MudBlazor
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BELMS.Frontend.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <MudThemeProvider Theme="@AppTheme.DarkTheme" IsDarkMode="false" />
    <MudThemeProvider  Theme="@AppTheme.DarkTheme" IsDarkMode="true" />
    <MudPopoverProvider @rendermode="InteractiveServer" />
    <MudDialogProvider 
                       MaxWidth="MaxWidth.ExtraSmall"
                       CloseButton="true"
                       BackdropClick="false"
                       NoHeader="true"
                       Position="DialogPosition.Center"
                       CloseOnEscapeKey="true"
                       @rendermode="InteractiveServer" />
    <MudSnackbarProvider />

    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/belms.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
