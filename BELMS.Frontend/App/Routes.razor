@using BELMS.Frontend.Features.Authentication.Components
@using BELMS.Frontend.Common.Layout
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState >
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <MudAlert Severity="Severity.Warning">You are not authorized to access this resource.</MudAlert>
                        </LayoutView>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>

        <NotFound>
            <LayoutView Layout="@typeof(AuthLayout)">
                <h1 class="h4">Page not found</h1>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
